---
import Base from '../../layouts/Base.astro';
import ListenLinks from '../../components/ListenLinks.astro';
import PlayIcon from '../../components/PlayIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { show, episodesNewestFirst, formatDate } from '../../podcast';

const [latest] = episodesNewestFirst;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${show.title} | A podcast from johwa`}
  description={`${show.tagline} ${show.description[2]}`}
  image={{ src: show.cover.share, width: 1200, height: 1200 }}
>
  <section class="band band--night on-dark" aria-labelledby="podcast-title">
    <div class="wrap split">
      <img
        class="pod-hero__cover"
        src={show.cover.src}
        srcset={`${show.cover.srcSmall} 600w, ${show.cover.src} 1200w`}
        sizes="(max-width: 760px) 85vw, 460px"
        alt={show.cover.alt}
        width="1200"
        height="1200"
        fetchpriority="high"
      />
      <div class="pod-hero__copy">
        <p class="eyebrow">The listening room</p>
        <h1 id="podcast-title" class="display pod-hero__title">{show.title}.</h1>
        <p class="lead">{show.tagline}</p>
        <div class="pod-hero__about">
          {show.description.map((p) => <p>{p}</p>)}
        </div>
        <p class="pod-hero__hosts">{show.hosts}</p>
        <div class="listen-row">
          {latest && <a class="btn btn--yellow arrow" href={`/podcast/${latest.slug}`}>Play the latest episode</a>}
          <ListenLinks />
        </div>
      </div>
    </div>
  </section>

  {latest && (
    <section class="wrap latest" aria-labelledby="latest-title">
      <p class="eyebrow">Latest episode</p>
      <h2 id="latest-title" class="display latest__title"><a href={`/podcast/${latest.slug}`}>{latest.title}</a></h2>
      <p class="latest__summary">{latest.description[0]}</p>
      {latest.playerSrc ? (
        <div class="player">
          <iframe src={latest.playerSrc} title={`Audio player: ${latest.title}`} loading="lazy" height="200" scrolling="no"></iframe>
        </div>
      ) : (
        <p class="player player--soon">Coming soon to Apple Podcasts and Spotify.</p>
      )}
    </section>
  )}

  <section class="wrap episodes" aria-labelledby="episodes-title">
    <div class="episodes__head">
      <h2 id="episodes-title" class="display episodes__title">All episodes.</h2>
    </div>
    <ol class="episode-list" reversed>
      {episodesNewestFirst.map((ep) => (
        <li class="episode-row">
          <span class="display episode-row__num" aria-hidden="true">{pad(ep.number)}</span>
          <div class="episode-row__text">
            <h3 class="episode-row__title"><a href={`/podcast/${ep.slug}`}>{ep.title}</a></h3>
            <p class="episode-row__meta">
              Episode {ep.number}
              {ep.published && <><span aria-hidden="true"> · </span><time datetime={ep.published}>{formatDate(ep.published)}</time></>}
            </p>
          </div>
          <span class="play play--dark" aria-hidden="true"><PlayIcon color="#F3EFE6" size={14} /></span>
        </li>
      ))}
    </ol>
  </section>

  <CtaBand />
</Base>
