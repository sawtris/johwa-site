---
// The johwa "J" mark, redrawn from the Wix logo on its own square grid (the dot is one square, the stem and
// the left arm are one square wide, and the bowl is a half circle).
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 28, class: className, title } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 314.5 470"
  height={size}
  width={Math.round((size * 314.5) / 470)}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
>
  <rect x="114.5" y="0" width="100" height="100" fill="currentColor"></rect>
  <path
    d="M0 261H100V312.4A57.25 57.25 0 0 0 214.5 312.4V100H314.5V312.4A157.25 157.25 0 0 1 0 312.4Z"
    fill="currentColor"></path>
</svg>
