---
import Logo from './Logo.astro';
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <a class="brand" href="/" aria-label="johwa home">
      <Logo height={36} />
    </a>
    <ul>
      <li><a href={SITE.footerLinkedin} rel="noopener" target="_blank">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li>© {year} johwa</li>
    </ul>
  </div>
</footer>
