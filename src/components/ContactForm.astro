---
import { SITE } from '../config';
import { contactPage } from '../content';
---

<form class="form" method="post" action="/api/contact" data-contact-form data-email={SITE.email}>
  <div class="form__row">
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" />
    </div>
    <div class="field">
      <label for="email">Work email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <label for="organization">Company <span class="optional">(optional)</span></label>
      <input id="organization" name="organization" type="text" autocomplete="organization" maxlength="200" />
    </div>
    <div class="field">
      <label for="role">Your role <span class="optional">(optional)</span></label>
      <input id="role" name="role" type="text" autocomplete="organization-title" maxlength="200" />
    </div>
  </div>
  <fieldset class="choices">
    <legend>What’s closest to your challenge?</legend>
    <div class="choices__list">
      {contactPage.topics.map((topic) => (
        <label class="choice"><input type="radio" name="topic" value={topic} />{topic}</label>
      ))}
    </div>
  </fieldset>
  <div class="field">
    <label for="message">What needs to change?</label>
    <textarea id="message" name="message" rows="6" required maxlength="5000"></textarea>
  </div>

  <!-- Spam trap. Real people never see or fill this in. -->
  <div class="form__trap" aria-hidden="true">
    <label for="website">Website</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form__actions">
    <button class="btn arrow" type="submit">Start a conversation</button>
    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </div>
  <noscript>
    <p>This form needs JavaScript. You can email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> instead.</p>
  </noscript>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const email = form.dataset.email ?? '';
    const label = button.textContent ?? 'Start a conversation';

    button.disabled = true;
    button.textContent = 'Sending...';
    button.classList.remove('arrow');
    status.textContent = '';
    status.classList.remove('is-error');

    const done = () => {
      button.disabled = false;
      button.textContent = label;
      button.classList.add('arrow');
    };

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = await response.json().catch(() => ({}));
      if (response.ok && result.ok) {
        form.reset();
        status.textContent = 'Thanks. Your message is on its way to us.';
        done();
        return;
      }
      throw new Error(result.error || 'The message did not send.');
    } catch (error) {
      const reason = error instanceof Error ? error.message : 'The message did not send.';
      status.textContent = `${reason} Try again, or email ${email} directly.`;
      status.classList.add('is-error');
      done();
    }
  });
</script>
