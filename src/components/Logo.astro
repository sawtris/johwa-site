  class={className}
  viewBox={viewBox}
  height={height}
  width={Math.round((height * vw) / vh)}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  xmlns="http://www.w3.org/2000/svg"
