---
// The johwa logo, from the brand pack (Brand/Logo, outlined artwork). It draws in currentColor, so set color in CSS.
// variant="combined" is the mark plus wordmark; variant="mark" is the mark alone.
interface Props {
  variant?: 'combined' | 'mark';
  height?: number;
  class?: string;
  title?: string;
}
const { variant = 'combined', height = 40, class: className, title } = Astro.props;
const viewBox = variant === 'combined' ? '25 28 700 172' : '27 31 198 160';
const [, , vw, vh] = viewBox.split(' ').map(Number);
---

